# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, those are intended to be generated or passed by CI/CD
*.tfvars
*.tfvars.json

# Allow example tfvars
!*.tfvars.example

# Ignore override files as they are usually used only locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Terraform execution plan binary files
*.plan
*.tfplan

# Operating System Files
.DS_Store
Thumbs.db

# IDE and Editor Files
.idea/
.vscode/
*.swp
*.swo

# Environment and Secrets
.env
.env.*
*.pem
*.key
*.pfx
secrets/
*.secret
